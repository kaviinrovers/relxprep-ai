# Backend (Express) environment variables
PORT=5000
NODE_ENV=development

# Supabase (Project Settings -> API)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only key. NEVER expose this in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI provider (Groq)
GROQ_API_KEY=your_groq_api_key
# Optional: override the default model (llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of allowed frontend origins (your Vercel URL). Empty = allow all.
CORS_ORIGIN=http://localhost:5173
